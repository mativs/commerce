# Local development credentials only; replace for any shared environment.
POSTGRES_USER=assessment
POSTGRES_PASSWORD=local_dev_only
POSTGRES_DB=assessment
# 'db' is the Compose hostname. Use localhost for a host-run API/Alembic.
DATABASE_URL=postgresql+asyncpg://assessment:local_dev_only@db:5432/assessment
ENVIRONMENT=development
# Comma-separated origins, without trailing slashes.
CORS_ORIGINS=http://localhost:5173
# Browser-facing address, NOT the Compose API hostname. This value is public.
VITE_API_URL=http://localhost:8000
